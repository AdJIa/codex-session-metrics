{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-session-metrics",
  "version": "0.1.8",
  "description": "仅读取 Codex 自身记录：Token、缓存占比、上下文、最近调用与最近完成轮次 TTFT/TPS。",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "会话指标",
        "shortDescription": "Token · 缓存 · 上下文 · 轮次 TTFT/TPS",
        "developerName": "Local tools",
        "category": "Productivity",
        "capabilities": [
          "Read"
        ],
        "brandColor": "#16a388"
      }
    }
  }
}
