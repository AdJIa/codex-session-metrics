{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "codex-session-metrics",
  "version": "0.1.10",
  "description": "Codex 本机会话指标：Token、缓存、上下文压缩、轮次 TTFT/TPS、工具耗时及近 10 轮趋势。",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "会话指标",
        "shortDescription": "Token · 缓存 · 上下文 · 轮次 TTFT/TPS",
        "developerName": "Local tools",
        "category": "Productivity",
        "capabilities": [
          "Read"
        ],
        "brandColor": "#16a388"
      }
    }
  }
}
